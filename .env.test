# .env.test

# 1) Tell Symfony to run in "test" mode
APP_ENV=test
APP_DEBUG=0

# 2) Point Doctrine’s DATABASE_URL to the “base” database name.
#    Because APP_ENV=test, Doctrine will automatically append “_test” → fkb_db_test
DATABASE_URL="mysql://root:root@fkb-mysql:3306/fkb_db"
CORS_ALLOW_ORIGIN="http://localhost:3000"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=87cc2fba9769e569ad114174d67c13cb686863c35208a6593630d05bc4bf2593