# Copy to `.env` and adjust: cp .env.example .env
# `.env` is git-ignored. Never put real secrets in this file.

APP_ENV=dev
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me

# Matches the `postgres` service of docker-compose.yml
DATABASE_URL="postgresql://fkb:fkb@postgres:5432/fkb_db?serverVersion=17&charset=utf8"

# JWT keys: php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# Image storage. In dev/test images are stored on the local disk (public/uploads)
# and this base URL must point at it. See README.md, "Local Image Storage".
R2_PUBLIC_BASE_URL=http://localhost:8787/uploads

# Production only (Cloudflare R2): not needed in dev/test.
# R2_REGION=auto
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=change-me
# R2_ACCESS_KEY_ID=change-me
# R2_SECRET_ACCESS_KEY=change-me

# Hosting settings (session and remember-me cookies, cross-origin rules). All optional:
# the defaults suit local dev (front on localhost:3000, API on localhost:8787, same site).
# SESSION_COOKIE_NAME=FKBSESSID
# COOKIE_SAMESITE=lax        # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_SECURE=false        # true | false
# COOKIE_DOMAIN=             # empty = host-only cookie
# ALLOWED_ORIGIN_REGEX=^http://localhost:(3000|8787)$   # CORS + CSRF origin check