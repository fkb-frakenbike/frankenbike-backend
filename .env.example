# Copy to `.env` and adjust: cp .env.example .env
# `.env` is git-ignored. Never put real secrets in this file.

APP_ENV=dev
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me

# Matches the `postgres` service of docker-compose.yml
DATABASE_URL="postgresql://fkb:fkb@postgres:5432/fkb_db?serverVersion=17&charset=utf8"

# JWT keys: php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

# Cloudflare R2 (image storage). Needed to upload images; leave the
# placeholders if you do not use uploads.
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_PUBLIC_BASE_URL=https://media.example.com
